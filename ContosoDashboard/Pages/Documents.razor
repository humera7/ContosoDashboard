@page "/documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1>My Documents</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ToggleUploadForm">
                <i class="bi bi-upload"></i> Upload Document
            </button>
        </div>
    </div>

    @if (showUploadForm)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Upload document</h5>
            </div>
            <div class="card-body">
                <EditForm Model="uploadModel" OnValidSubmit="HandleUploadAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Title</label>
                            <InputText class="form-control" @bind-Value="uploadModel.Title" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <InputSelect class="form-select" @bind-Value="uploadModel.Category">
                                <option value="Project Documents">Project Documents</option>
                                <option value="Team Resources">Team Resources</option>
                                <option value="Personal Files">Personal Files</option>
                                <option value="Reports">Reports</option>
                                <option value="Presentations">Presentations</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="uploadModel.Description" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Project (optional)</label>
                            <InputSelect class="form-select" @bind-Value="uploadModel.ProjectId">
                                <option value="">None</option>
                                @foreach (var project in projects)
                                {
                                    <option value="@project.ProjectId">@project.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tags</label>
                            <InputText class="form-control" @bind-Value="uploadModel.Tags" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Choose file</label>
                            <InputFile OnChange="HandleFileSelected" class="form-control" />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(uploadError))
                    {
                        <div class="alert alert-danger mt-3">@uploadError</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(uploadSuccess))
                    {
                        <div class="alert alert-success mt-3">@uploadSuccess</div>
                    }

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" disabled="@isUploading">
                            @(isUploading ? "Uploading..." : "Save Document")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (documents == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!documents.Any())
    {
        <div class="alert alert-info">No documents found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Project</th>
                        <th>Uploaded</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td>
                                <strong>@document.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(document.Description))
                                {
                                    <br />
                                    <small class="text-muted">@document.Description</small>
                                }
                            </td>
                            <td>@document.Category</td>
                            <td>@(document.Project?.Name ?? "Personal")</td>
                            <td>@document.CreatedDate.ToString("MMM dd, yyyy")</td>
                            <td>@FormatFileSize(document.FileSizeBytes)</td>
                            <td>
                                <span class="badge bg-@GetStatusColor(document.Status)">@document.Status</span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => DownloadDocument(document.DocumentId)">Download</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Document> documents = new();
    private List<Project> projects = new();
    private int currentUserId;
    private bool showUploadForm;
    private bool isUploading;
    private string uploadError = string.Empty;
    private string uploadSuccess = string.Empty;
    private IBrowserFile? selectedFile;

    private UploadDocumentModel uploadModel = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            projects = await ProjectService.GetUserProjectsAsync(currentUserId);
            documents = await DocumentService.GetUserDocumentsAsync(currentUserId);
        }
    }

    private void ToggleUploadForm()
    {
        showUploadForm = !showUploadForm;
        uploadError = string.Empty;
        uploadSuccess = string.Empty;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task HandleUploadAsync()
    {
        if (selectedFile == null)
        {
            uploadError = "Please choose a file before uploading.";
            return;
        }

        try
        {
            isUploading = true;
            uploadError = string.Empty;
            uploadSuccess = string.Empty;

            using var stream = selectedFile.OpenReadStream(25 * 1024 * 1024);
            int? projectId = string.IsNullOrWhiteSpace(uploadModel.ProjectId)
                ? null
                : int.Parse(uploadModel.ProjectId);

            await DocumentService.UploadAsync(
                currentUserId,
                uploadModel.Title,
                uploadModel.Description,
                uploadModel.Category,
                selectedFile.Name,
                stream,
                selectedFile.ContentType,
                projectId,
                uploadModel.Tags);

            uploadSuccess = "Document uploaded successfully.";
            uploadModel = new UploadDocumentModel();
            selectedFile = null;
            documents = await DocumentService.GetUserDocumentsAsync(currentUserId);
            projects = await ProjectService.GetUserProjectsAsync(currentUserId);
            showUploadForm = false;
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DownloadDocument(int documentId)
    {
        var document = await DocumentService.GetByIdAsync(documentId, currentUserId);
        if (document == null)
        {
            uploadError = "You do not have access to this document.";
            return;
        }

        var relativePath = document.StoredRelativePath;
        var fileStream = await new LocalFileStorageService().DownloadAsync(relativePath);
        var bytes = new byte[fileStream.Length];
        await fileStream.ReadExactlyAsync(bytes, 0, (int)fileStream.Length);

        var base64 = Convert.ToBase64String(bytes);
        await InvokeAsync(() => NavigationManager.NavigateTo($"/documents/download/{documentId}", forceLoad: true));
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / (1024 * 1024)} MB";
    }

    private static string GetStatusColor(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.PendingScan => "warning",
            DocumentStatus.Approved => "success",
            DocumentStatus.Quarantined => "danger",
            DocumentStatus.Failed => "secondary",
            _ => "secondary"
        };
    }

    private class UploadDocumentModel
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Category { get; set; } = "Project Documents";
        public string? ProjectId { get; set; }
        public string Tags { get; set; } = string.Empty;
    }
}
